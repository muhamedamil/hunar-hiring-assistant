APP_ENV=development

# Required by the FastAPI API and worker.
# Use the local Supabase Postgres URL during local development, e.g.
# postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# For hosted Supabase use the backend-only direct/session-pooler connection string.
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=300

# Database integration tests intentionally read TEST_DATABASE_URL from the shell
# environment so tests cannot silently target the normal application database.
# Example PowerShell:
# $env:TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"


# Optional Module 1 AI-assisted Job Description analysis. Manual Job creation works
# when this is unset. Keep this backend-only and never expose it as NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_READ_TIMEOUT_SECONDS=60
