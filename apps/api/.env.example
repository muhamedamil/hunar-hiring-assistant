APP_ENV=development

# Required by the FastAPI API and worker.
# Use the local Supabase Postgres URL during local development, e.g.
# postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# For hosted Supabase use the backend-only direct/session-pooler connection string.
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=300

# Database integration tests intentionally read TEST_DATABASE_URL from the shell
# environment so tests cannot silently target the normal application database.
# Example PowerShell:
# $env:TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"


# Optional Module 1 AI-assisted Job Description analysis. Manual Job creation works
# when this is unset. Keep this backend-only and never expose it as NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_READ_TIMEOUT_SECONDS=60

# Module 3 Apollo people search and contact enrichment. Keep all values backend-only.
APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io/api/v1
# Public HTTPS origin of this API, e.g. https://api.example.com
APOLLO_WEBHOOK_BASE_URL=
# Random backend-only secret used to sign enrichment-specific callback URLs.
APOLLO_WEBHOOK_SIGNING_SECRET=
APOLLO_SEARCH_READ_TIMEOUT_SECONDS=30
APOLLO_ENRICHMENT_READ_TIMEOUT_SECONDS=60
SOURCING_SEARCH_STALE_SECONDS=300

# Module 6: pre-provisioned ACTIVE English agent only; no live calls without configuration.
HUNAR_API_KEY=
HUNAR_API_BASE_URL=https://api.voice.hunar.ai/external/v1
HUNAR_SCREENING_AGENT_IDS_JSON={}
HUNAR_DEFAULT_LANGUAGE=ENGLISH
HUNAR_DEFAULT_TIMEZONE=Asia/Kolkata
HUNAR_READ_TIMEOUT_SECONDS=30
HUNAR_CALL_SUMMARY_CALLBACK_URL=
HUNAR_WEBHOOK_API_KEYS_JSON=[]
